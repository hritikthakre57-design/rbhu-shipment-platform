DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/shipment_platform?schema=public"
NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
ANALYTICS_URL=http://127.0.0.1:5001
# For Groq: https://api.groq.com/openai/v1
# For Azure OpenAI: use the compatible Azure endpoint for your deployment.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
CHAT_HISTORY_LIMIT=10
